# Salin berkas ini menjadi .env.local, lalu isi dari dasbor Supabase.
# .env.local tidak ikut di-commit.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings > API Keys > Publishable key (sb_publishable_…).
# Proyek lama boleh memakai anon key di sini. Jangan pernah menaruh secret key atau service_role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hanya dipakai skrip migrasi (npm run db:*), tidak pernah dibaca aplikasi web.
# Tombol Connect > Session pooler. Tulis di dalam tanda kutip dan ganti [YOUR-PASSWORD].
SUPABASE_DB_URL=""

# Opsional. Peta dasar untuk peta sekitar SPBU. Bawaan: ubin OpenStreetMap, cukup untuk pemakaian ringan.
# Untuk pemakaian luas, ganti dengan penyedia ubin berlangganan (pola {z}/{x}/{y}) dan atribusinya.
# NEXT_PUBLIC_PETA_UBIN=
# NEXT_PUBLIC_PETA_ATRIBUSI=

# Cloudflare R2 untuk foto SPBU dan lahan. Dipakai skrip ../unggah_r2.py, tidak dibaca aplikasi.
# Dasbor Cloudflare > R2 > Overview > Account Details > API Tokens > Manage > Create Account API token
# (izin "Object Read & Write", dibatasi ke bucket ini). Secret hanya tampil sekali.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Alamat dasar foto, tanpa garis miring di akhir.
# /foto  = lewat aplikasi ini (disarankan). Server mengambil foto dari R2 dengan R2_* di atas, jadi R2_* juga
#          harus diisi di Vercel. Untuk Vercel cukup token "Object Read only".
# Jangan memakai alamat https://pub-xxxx.r2.dev: alamat itu diblokir di sebagian jaringan Indonesia.
# Bila bucket sudah dipasangi domain sendiri, isi dengan domain itu, mis. https://foto.contoh.id
NEXT_PUBLIC_GAMBAR_URL=/foto
